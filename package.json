    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "parse5": "^8.0.1",
    "prisma": "^6.19.3",
