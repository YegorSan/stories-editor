generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  MONTH
  YEAR
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILURE
  EXPIRED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscription Subscription?
  payments     Payment[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan
  amountKop     Int
  monoInvoiceId String        @unique
  status        PaymentStatus @default(CREATED)
  createdAt     DateTime      @default(now())
  paidAt        DateTime?

  @@index([userId, createdAt])
  @@index([status])
}
