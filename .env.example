# --- Database (local: docker compose up -d) ---
DATABASE_URL="postgresql://kadr:kadr@localhost:5432/kadr?schema=public"

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET="replace-me"
# Public site URL (Auth callbacks)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# First admin (seeded by `npm run db:seed`)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# --- Monobank Acquiring ---
# Test token: https://api.monobank.ua/ (personal token works in sandbox)
# Live token: monoбізнес → інтернет-еквайринг → API
# Connect acquiring: describe the product as «доступ до онлайн-сервісу / ПЗ»
MONO_TOKEN=""
# Optional override; default https://api.monobank.ua
MONO_API_BASE="https://api.monobank.ua"

# --- PostHog (optional; analytics skipped when empty) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Public legal / FOP block ---
NEXT_PUBLIC_FOP_NAME="ФОП Прізвище Ім'я По батькові"
NEXT_PUBLIC_FOP_EDRPOU="0000000000"
NEXT_PUBLIC_FOP_EMAIL="hello@example.com"
NEXT_PUBLIC_FOP_ADDRESS="Україна"
